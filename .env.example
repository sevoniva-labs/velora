# ============================================================================
# Velora 环境变量示例：复制为 .env 后按需修改。
# 禁止提交真实密码 / Secret / Token；本文件仅提供结构与默认值。
# ============================================================================

# --- Velora Server ---
VELORA_PORT=8080
VELORA_ENV=development
LOG_LEVEL=info

# --- PostgreSQL（Velora 独立 database，与 casdoor 隔离） ---
# 本地开发常用：postgres://velora:velora@127.0.0.1:5432/velora?sslmode=disable
DATABASE_URL=postgres://velora:velora@127.0.0.1:5432/velora?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# --- Redis（可选；Phase C3 分布式限流 + 账户锁定） ---
# 本地：docker compose --profile redis up -d redis
# REDIS_URL=redis://localhost:6379/0

# --- Casdoor OIDC ---
CASDOOR_ISSUER=http://localhost:8443
# 由 ./scripts/init-casdoor.sh 生成（方式 A），或在 Casdoor UI 创建 velora 应用后填写（方式 B）
CASDOOR_CLIENT_ID=velora
CASDOOR_CLIENT_SECRET=change-me-to-a-real-client-secret
CASDOOR_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback
# 回调后默认落点；由 OIDC state 中的 redirect 参数覆盖
CASDOOR_DEFAULT_REDIRECT=/home
# Casdoor 管理员凭据：仅用于服务端同步应用列表（读取管理 API），不用于用户认证。
# 生产环境必须显式配置（compose 生产 overlay 强制必填）。
CASDOOR_ADMIN_USERNAME=admin
CASDOOR_ADMIN_PASSWORD=change-me-to-a-real-admin-password

# --- Session / Cookie ---
# 生产环境必须替换为至少 32 字节随机值：openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-secret
# 会话有效期（小时）：无状态会话在有效期内不重验 Casdoor 角色，
# 角色回收最长延迟一个 TTL，生产可按需调小（如 24）。
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- 邮件模块 ---
# 邮箱凭证加密密钥：base64 编码的 32 字节独立密钥（openssl rand -base64 32）。
# 生产环境必须显式配置且独立于 SESSION_SECRET（config 生产模式强制校验）。
MAIL_CREDENTIAL_KEY=
# 邮件定时补偿同步间隔（分钟，0 禁用；IMAP IDLE 实时推送属 Phase 2）
MAIL_SYNC_INTERVAL_MINUTES=10

# --- Velora 角色约定（来自 Casdoor） ---
VELORA_ADMIN_ROLE=velora_admin

# --- CORS（浏览器直连后端时才需要；同源部署可留空） ---
CORS_ALLOWED_ORIGINS=
# --- 可信反向代理网段（经 nginx/网关部署时配置，保留真实客户端 IP；默认仅回环） ---
TRUSTED_PROXIES=127.0.0.1,::1

# --- 健康检查 ---
HEALTH_CHECK_TIMEOUT_SECONDS=5

# --- Docker 国内镜像（构建时可用 DOCKER_REGISTRY 覆盖） ---
DOCKER_REGISTRY=docker.m.daocloud.io

# --- Cloudflare Turnstile 人机验证（登录页防 bot 撞库/暴力破解） ---
# 在 https://dash.cloudflare.com 的 Turnstile 控制台创建 widget，获取 Site Key / Secret Key。
# 两者都配置后登录强制要求人机验证；留空则降级（仍由限流 + 账户锁定兜底）。
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
