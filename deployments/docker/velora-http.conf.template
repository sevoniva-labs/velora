# Velora Web Nginx 配置（HTTP 服务块 · 开发/默认形态）。
# 由 docker-entrypoint.sh 渲染到 /etc/nginx/conf.d/default.conf。
# 生产形态（TLS）见 velora-http-redirect.conf.template + velora-https.conf.template。

gzip on;
gzip_types text/plain text/css application/json application/javascript image/svg+xml;
gzip_min_length 1024;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 安全响应头（SPA 文档层防护）
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # 管理员可配置 http:// 图标，img-src 显式放行 http/https
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # SPA 路由回退（index.html 与非指纹化公共文件：每次加载协商缓存，保证更新即时生效）
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }

    # 指纹化构建产物（文件名含内容 hash）：长缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # API 反向代理到 Velora Server
    location /api/ {
        proxy_pass ${VELORA_API_PROXY_PASS:-http://server:8080};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 30s;
    }

    # Casdoor 反代（生产：让 Casdoor 登录页位于 Velora 域名下，用户无感）
    location /casdoor/ {
        proxy_pass http://casdoor:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 健康检查
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
