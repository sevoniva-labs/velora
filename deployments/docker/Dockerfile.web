# Velora Web 构建 + Nginx 托管镜像。
ARG DOCKER_REGISTRY=docker.m.daocloud.io

FROM ${DOCKER_REGISTRY}/library/node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml* web/.npmrc ./
RUN pnpm install --frozen-lockfile || pnpm install
COPY web/ .
RUN pnpm build

FROM ${DOCKER_REGISTRY}/library/nginx:1.27-alpine
COPY deployments/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
