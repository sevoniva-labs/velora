[Unit]
Description=Velora encrypted dual-database production backup
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathExists=/opt/velora/prod/runtime/compose/prod.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/velora/source
ExecStart=/usr/bin/flock -n /run/velora-backup.lock /opt/velora/source/scripts/run-production-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/velora/prod/runtime/backups /opt/velora/prod/runtime/evidence /run

[Install]
WantedBy=multi-user.target
