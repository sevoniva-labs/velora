# Import approved images into the organization's domestic Harbor first, then
# replace each placeholder with the immutable digest recorded by the import job.
POSTGRES_IMAGE=harbor.internal.example/approved/postgresql@sha256:REPLACE_WITH_VERIFIED_DIGEST
MYSQL_IMAGE=harbor.internal.example/approved/mysql@sha256:REPLACE_WITH_VERIFIED_DIGEST
REDIS_IMAGE=harbor.internal.example/approved/redis@sha256:REPLACE_WITH_VERIFIED_DIGEST
KAFKA_IMAGE=harbor.internal.example/approved/kafka@sha256:REPLACE_WITH_VERIFIED_DIGEST
ROCKETMQ_IMAGE=harbor.internal.example/approved/rocketmq@sha256:REPLACE_WITH_VERIFIED_DIGEST
ELASTICSEARCH_IMAGE=harbor.internal.example/approved/elasticsearch@sha256:REPLACE_WITH_VERIFIED_DIGEST
S3_IMAGE=harbor.internal.example/approved/s3-contract-server@sha256:REPLACE_WITH_VERIFIED_DIGEST
S3_MC_IMAGE=harbor.internal.example/approved/s3-contract-client@sha256:REPLACE_WITH_VERIFIED_DIGEST
NACOS_IMAGE=harbor.internal.example/approved/nacos@sha256:REPLACE_WITH_VERIFIED_DIGEST
PROMETHEUS_IMAGE=harbor.internal.example/approved/prometheus@sha256:REPLACE_WITH_VERIFIED_DIGEST
OTEL_COLLECTOR_IMAGE=harbor.internal.example/approved/otel-collector-contrib@sha256:REPLACE_WITH_VERIFIED_DIGEST
