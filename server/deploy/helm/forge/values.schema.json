{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "webCSPFrameSources": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\r\\n;*'\\\"]*$"
        },
        "webCSPConnectSources": {
          "type": "string",
          "maxLength": 4096
        },
        "webCSPWujieEnabled": {
          "type": "boolean"
        },
        "webCSPWujieApprovalRef": {
          "type": "string",
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "webCSPWujieEnabled": { "const": true }
            },
            "required": ["webCSPWujieEnabled"]
          },
          "then": {
            "properties": {
              "webCSPWujieApprovalRef": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{5,127}$"
              }
            },
            "required": ["webCSPWujieApprovalRef"]
          },
          "else": {
            "properties": {
              "webCSPWujieApprovalRef": { "maxLength": 0 }
            }
          }
        }
      ]
    }
  }
}
