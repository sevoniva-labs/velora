# Production deployment variables. Inject real values from Secret Manager/CI;
# this file must never contain credentials.
DOCKER_REGISTRY=docker.m.daocloud.io
GOPROXY=https://goproxy.cn
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

VELORA_EXTERNAL_URL=velora.example.com
VELORA_DATABASE_DSN=postgres://velora_app:URL_ENCODED_PASSWORD@postgres:5432/velora?sslmode=verify-full
VELORA_STORAGE_PROVIDER=s3-compatible
VELORA_STORAGE_ENDPOINT=https://objects.example.internal
VELORA_STORAGE_REGION=cn-north-1
VELORA_STORAGE_BUCKET=velora-prod
VELORA_STORAGE_PREFIX=velora-prod
VELORA_STORAGE_PATH_STYLE=true
VELORA_STORAGE_ACCESS_KEY=replace-with-object-store-access-key
VELORA_STORAGE_SECRET_KEY=replace-with-object-store-secret-key
VELORA_STORAGE_SSE_MODE=kms
VELORA_STORAGE_SSE_KMS_KEY_ID=replace-with-approved-kms-key-id
VELORA_CRYPTO_PROVIDER=standard
VELORA_CRYPTO_KEY_VERSION=v1
VELORA_OIDC_ISSUER=https://casdoor.example.com
VELORA_OIDC_CLIENT_ID=replace-with-casdoor-oidc-client-id
# Casdoor redirects to the SPA callback; the SPA exchanges the one-time code with Velora.
VELORA_OIDC_REDIRECT_URL=https://velora.example.com/auth/callback
VELORA_CASDOOR_ACCOUNT_URL=https://casdoor.example.com/account
VELORA_OIDC_PROVIDER_ENABLED=false
VELORA_BOOTSTRAP_ADMIN=replace-with-break-glass-admin
VELORA_ALLOWED_ORIGINS=https://velora.example.com
TRUSTED_PROXIES=10.0.0.0/8

REDIS_PASSWORD=replace-with-random-redis-password
REDIS_TLS_CA_FILE=/secure/velora/redis/ca.pem
REDIS_TLS_CERT_FILE=/secure/velora/redis/server.crt
REDIS_TLS_KEY_FILE=/secure/velora/redis/server.key
VELORA_CRYPTO_KEY_FILE=/secure/velora/secrets/velora-crypto-key
VELORA_BOOTSTRAP_PASSWORD_FILE=/secure/velora/secrets/bootstrap-password
CASDOOR_OIDC_CLIENT_SECRET_FILE=/secure/velora/secrets/casdoor-oidc-client-secret
POSTGRES_CONTAINER=velora-prod-postgres

# Database bootstrap is performed only on an empty volume.
POSTGRES_SUPERUSER=replace-with-postgres-bootstrap-user
POSTGRES_SUPERUSER_PASSWORD=replace-with-postgres-bootstrap-password
POSTGRES_APP_USER=velora_app
POSTGRES_APP_PASSWORD=replace-with-velora-db-password
POSTGRES_IDP_USER=casdoor_app
POSTGRES_IDP_PASSWORD=replace-with-casdoor-db-password
CASDOOR_DATA_SOURCE_NAME=user=casdoor_app password=URL_ENCODED_PASSWORD host=postgres port=5432 sslmode=require dbname=casdoor

LOG_LEVEL=info
GRAFANA_ADMIN_USER=replace-with-grafana-admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
