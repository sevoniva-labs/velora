[Unit]
Description=Velora production synthetic health and certificate check
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/flock -n /run/velora-health.lock /opt/velora/source/scripts/check-production-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/velora/prod/runtime/evidence /run
