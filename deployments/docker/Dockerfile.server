# Velora Server 多阶段构建镜像。
# 中国大陆加速：DOCKER_REGISTRY=docker.m.daocloud.io（默认）；官方源 DOCKER_REGISTRY=docker.io
ARG DOCKER_REGISTRY=docker.m.daocloud.io

FROM ${DOCKER_REGISTRY}/library/golang:1.26.6-alpine AS builder
WORKDIR /src
# Go 模块代理：默认国内加速，官方源构建时传 GOPROXY=https://proxy.golang.org,direct
ARG GOPROXY=https://goproxy.cn
ENV GOPROXY=${GOPROXY}
# 先拷贝依赖清单以利用构建缓存
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/velora ./cmd/server \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/velora-worker ./cmd/worker \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/velora-connect ./cmd/velora-connect \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/velora-migrate ./cmd/migrate \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/velora-storage-check ./cmd/storage-check

FROM ${DOCKER_REGISTRY}/library/alpine:3.21
# 国内构建默认使用阿里云 Alpine 镜像，避免构建阶段访问境外源。
RUN sed -i 's#https\?://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories \
    && apk add --no-cache ca-certificates tzdata wget \
    && adduser -D -u 10001 velora
USER velora
WORKDIR /app
COPY --from=builder /out/velora /usr/local/bin/velora
COPY --from=builder /out/velora-worker /usr/local/bin/velora-worker
COPY --from=builder /out/velora-connect /usr/local/bin/velora-connect
COPY --from=builder /out/velora-migrate /usr/local/bin/velora-migrate
COPY --from=builder /out/velora-storage-check /usr/local/bin/velora-storage-check
EXPOSE 8080
ENTRYPOINT ["velora"]
