# Velora Web 构建 + Nginx 托管镜像。
# 通过 docker-entrypoint.sh 用环境变量渲染 nginx 配置（TLS 开关 / API 反代目标 / Casdoor 反代）。
ARG DOCKER_REGISTRY=docker.m.daocloud.io
# 国内构建默认使用 npmmirror，必要时可通过 --build-arg 覆盖。
ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

FROM ${DOCKER_REGISTRY}/library/node:22-alpine AS builder
ARG NPM_CONFIG_REGISTRY
ENV COREPACK_NPM_REGISTRY=${NPM_CONFIG_REGISTRY}
WORKDIR /app
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml* web/.npmrc ./
RUN pnpm config set registry "${NPM_CONFIG_REGISTRY}" \
    && pnpm install --frozen-lockfile
COPY web/ .
RUN pnpm build

FROM ${DOCKER_REGISTRY}/library/nginx:1.27-alpine
# 配置模板 + 渲染脚本（先于 nginx 启动执行）。
# 官方 20-envsubst-on-templates.sh 会先渲染 templates/，与自定义渲染冲突，故移除；
# 由 30-velora-envsubst.sh 独占渲染。
COPY deployments/docker/velora-http.conf.template /etc/nginx/templates/
COPY deployments/docker/velora-http-redirect.conf.template /etc/nginx/templates/
COPY deployments/docker/velora-https.conf.template /etc/nginx/templates/
COPY deployments/docker/docker-entrypoint.sh /docker-entrypoint.d/30-velora-envsubst.sh
RUN chmod +x /docker-entrypoint.d/30-velora-envsubst.sh \
    && rm -f /docker-entrypoint.d/20-envsubst-on-templates.sh \
    && rm -f /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80 443
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
