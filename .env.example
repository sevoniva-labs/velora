# Core bootstrap (required at startup for first run)
VELORA_BOOTSTRAP_ADMIN=admin
VELORA_BOOTSTRAP_PASSWORD=<set one-time strong password>

# Secret handling: prefer *_FILE, plain env only for bootstrapping/dev.
VELORA_CRYPTO_KEY=<at least 32-byte base64/plain key>

# Signed base images mirrored into the enterprise Harbor. Digest is mandatory.
VELORA_NODE_IMAGE=registry.example.cn/base/node@sha256:<64-lowercase-hex>
VELORA_GO_IMAGE=registry.example.cn/base/golang@sha256:<64-lowercase-hex>
VELORA_RUNTIME_IMAGE=registry.example.cn/base/velora-runtime@sha256:<64-lowercase-hex>

# Database
VELORA_DATABASE_DSN=postgres://velora:velora_dev@postgres:5432/velora?sslmode=disable
VELORA_DATABASE_READONLY_DSN=

# Cache
VELORA_CACHE_PROVIDER=memory
VELORA_REDIS_ADDRESSES=

# Messaging / Search
VELORA_MESSAGING_PROVIDER=disabled
# When RocketMQ is enabled, add audit-events to this allowlist for reliable audit forwarding.
# VELORA_ROCKETMQ_TOPICS=business-events,audit-events
VELORA_SEARCH_PROVIDER=disabled
VELORA_KAFKA_BROKERS=
VELORA_SEARCH_URLS=

# Storage - support any S3-compatible object storage, not just MinIO
VELORA_STORAGE_PROVIDER=local
# VELORA_STORAGE_PROVIDER=s3
# VELORA_STORAGE_PROVIDER=minio      # MinIO
# VELORA_STORAGE_PROVIDER=cos        # 腾讯云 COS
# VELORA_STORAGE_PROVIDER=oss        # 阿里云 OSS
# VELORA_STORAGE_PROVIDER=ceph-rgw   # Ceph RGW
# VELORA_STORAGE_PROVIDER=obs        # 华为云 OBS
# VELORA_STORAGE_ENDPOINT=http://s3:9000
# VELORA_STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# VELORA_STORAGE_PATH_STYLE=true      # MinIO/Ceph 通常 true，AWS S3 常用 false
VELORA_STORAGE_REGION=us-east-1
VELORA_STORAGE_BUCKET=velora
VELORA_STORAGE_PATH_STYLE=true
VELORA_STORAGE_TLS=false
# For compose templates that include the optional S3 bucket bootstrap helper:
# true: create bucket during stack startup
# false: keep bucket lifecycle in external S3 platform (COS/OSS/R2/etc.)
S3_BUCKET_AUTO_CREATE=true
VELORA_STORAGE_ACCESS_KEY=
VELORA_STORAGE_SECRET_KEY=

# Federated OIDC (preferred production mode: Authorization Code + PKCE).
# Casdoor remains the external identity source; Velora does not administer it.
# VELORA_AUTH_MODE=oidc
# VELORA_OIDC_NAME=casdoor
# VELORA_OIDC_ISSUER=https://casdoor.example.com
# VELORA_OIDC_CLIENT_ID=velora-portal
# VELORA_OIDC_CLIENT_SECRET_FILE=/run/secrets/casdoor-oidc-client-secret
# VELORA_OIDC_REDIRECT_URL=https://velora.example.com/auth/callback
# VELORA_CASDOOR_ACCOUNT_URL=https://casdoor.example.com/account
# VELORA_CASDOOR_ADMIN_URL=https://casdoor.example.com
# VELORA_CASDOOR_ALLOWED_HOSTS=casdoor.example.com
# VELORA_APPLICATION_ONBOARDING_V2=false
# VELORA_CASDOOR_ADMIN_ENTRY_ENABLED=false
# VELORA_CASDOOR_APPLICATION_AUTOMATION_ENABLED=false
# VELORA_CASDOOR_AUTOMATION_TOKEN=development-only-token
# Optional local compatibility mode: keep the credential form on Velora and
# verify it server-to-server with Casdoor. This is not standard OIDC/PKCE and
# must be an explicit risk acceptance in a regulated production deployment.
# VELORA_CASDOOR_PASSWORD_LOGIN_ENABLED=false
# VELORA_CASDOOR_APPLICATION=velora-portal
# VELORA_CASDOOR_ORGANIZATION=built-in
# VELORA_OIDC_INTERNAL_URL=
VELORA_OIDC_PROVIDER_ENABLED=false

# Cloudflare Turnstile for the Velora-hosted login form. Leave unset locally
# to keep the challenge disabled. Production password-form deployments must
# provide all values; never commit the secret.
# VELORA_TURNSTILE_SITE_KEY=0x4AAAA...
# VELORA_TURNSTILE_SECRET_FILE=/run/secrets/velora-turnstile-secret
# VELORA_TURNSTILE_HOSTNAMES=portal.example.com
# VELORA_TURNSTILE_ACTION=login

# Nacos
VELORA_DISCOVERY_PROVIDER=disabled
VELORA_REMOTE_CONFIG_PROVIDER=disabled
VELORA_NACOS_SERVERS=
VELORA_NACOS_NAMESPACE=
VELORA_NACOS_GROUP=DEFAULT_GROUP
VELORA_NACOS_CLUSTER=DEFAULT
VELORA_NACOS_TLS_REQUIRED=false
VELORA_NACOS_TLS_CA_FILE=
VELORA_NACOS_TLS_CERT_FILE=
VELORA_NACOS_TLS_KEY_FILE=
VELORA_NACOS_TLS_SERVER_NAME=
VELORA_NACOS_CONFIG_GROUP=DEFAULT_GROUP
VELORA_NACOS_CONFIG_DATA_ID=

# Security
# 本地 Compose 默认允许 Vite 5173 和 Nginx 8443；自定义 Web 地址时按逗号分隔填写精确 origin。
VELORA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443
VELORA_TRUSTED_PROXIES=
VELORA_LOGIN_MAX_FAILURES=5
VELORA_LOGIN_LOCK_DURATION=30m
VELORA_SESSION_TTL=12h
VELORA_PASSWORD_MIN_LENGTH=12
VELORA_PASSWORD_REQUIRE_UPPER=true
VELORA_PASSWORD_REQUIRE_LOWER=true
VELORA_PASSWORD_REQUIRE_DIGIT=true
VELORA_PASSWORD_REQUIRE_SYMBOL=true
VELORA_PASSWORD_HISTORY=5
VELORA_PASSWORD_MAX_AGE_DAYS=90

# Compliance / retention policy
VELORA_COMPLIANCE_PROFILE=mlps3
VELORA_AUDIT_RETENTION_DAYS=365
VELORA_NETWORK_LOG_RETENTION_DAYS=183

# Server / app
VELORA_ENV=production
VELORA_REGION=cn-north
VELORA_ZONE=zone-a
VELORA_PUBLIC_URL=https://velora.example.com
VELORA_WEB_DIR=/app/web
VELORA_SECURE_COOKIES=true
VELORA_SAME_SITE=lax
