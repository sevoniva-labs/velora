# Production deployment variables. Inject real values from Secret Manager/CI;
# this file must never contain credentials. Replace image tags with observed
# DaoCloud repository digests during release preparation.
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
CASDOOR_IMAGE=docker.m.daocloud.io/casbin/casdoor:v1.762.0
DOCKER_REGISTRY=docker.m.daocloud.io
GOPROXY=https://goproxy.cn
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

VELORA_EXTERNAL_URL=home.sevoniva.com
VELORA_AUTH_HOST=auth.sevoniva.com
VELORA_COMPLIANCE_PROFILE=standard
VELORA_CERTS_DIR=/opt/velora/prod/runtime/certs
VELORA_ACME_WEBROOT=/opt/velora/prod/runtime/acme
VELORA_DATABASE_DSN_FILE=/secure/velora/secrets/velora-database-dsn
VELORA_STORAGE_PROVIDER=s3-compatible
VELORA_STORAGE_ENDPOINT=https://objects.example.internal
VELORA_STORAGE_REGION=cn-north-1
VELORA_STORAGE_BUCKET=velora-prod
VELORA_STORAGE_PREFIX=velora-prod
VELORA_STORAGE_PATH_STYLE=true
VELORA_STORAGE_ACCESS_KEY_FILE=/secure/velora/secrets/object-storage-access-key
VELORA_STORAGE_SECRET_KEY_FILE=/secure/velora/secrets/object-storage-secret-key
VELORA_STORAGE_SSE_MODE=kms
VELORA_STORAGE_SSE_KMS_KEY_ID=replace-with-approved-kms-key-id
VELORA_CRYPTO_PROVIDER=standard
VELORA_CRYPTO_ADAPTER=software
VELORA_CRYPTO_KEY_VERSION=v1
VELORA_SESSION_TTL=1h
VELORA_OIDC_ISSUER=https://auth.sevoniva.com
VELORA_OIDC_INTERNAL_URL=http://casdoor:8000
VELORA_OIDC_CLIENT_ID=replace-with-casdoor-oidc-client-id
# Casdoor redirects to the SPA callback; the SPA exchanges the one-time code with Velora.
VELORA_OIDC_REDIRECT_URL=https://home.sevoniva.com/auth/callback
VELORA_OIDC_POST_LOGOUT_REDIRECT_URL=https://home.sevoniva.com/login
VELORA_OIDC_LOGOUT_URL=https://auth.sevoniva.com/_velora/logout
VELORA_CASDOOR_ACCOUNT_URL=https://auth.sevoniva.com/account
VELORA_CASDOOR_ADMIN_URL=https://auth.sevoniva.com
VELORA_CASDOOR_ALLOWED_HOSTS=auth.sevoniva.com
VELORA_CASDOOR_PASSWORD_LOGIN_ENABLED=true
VELORA_CASDOOR_APPLICATION=replace-with-casdoor-velora-application
VELORA_CASDOOR_ORGANIZATION=admin
VELORA_CASDOOR_IDENTITY_MANAGEMENT_ENABLED=true
VELORA_CASDOOR_IDENTITY_CLIENT_ID=replace-with-dedicated-casdoor-m2m-client-id
VELORA_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
VELORA_TURNSTILE_HOSTNAMES=home.sevoniva.com
VELORA_TURNSTILE_ACTION=login
VELORA_APPLICATION_ONBOARDING_V2=true
VELORA_CASDOOR_ADMIN_ENTRY_ENABLED=true
VELORA_CASDOOR_APPLICATION_AUTOMATION_ENABLED=false
VELORA_CASDOOR_AUTOMATION_URL=http://casdoor:8000
VELORA_CASDOOR_APPLICATION_OWNER=admin
VELORA_OIDC_PROVIDER_ENABLED=false
VELORA_BOOTSTRAP_ADMIN=replace-with-break-glass-admin
VELORA_ALLOWED_ORIGINS=https://home.sevoniva.com
TRUSTED_PROXIES=172.16.0.0/12

REDIS_PASSWORD_FILE=/secure/velora/secrets/redis-password
REDIS_TLS_CA_FILE=/secure/velora/redis/ca.pem
REDIS_TLS_CERT_FILE=/secure/velora/redis/server.crt
REDIS_TLS_KEY_FILE=/secure/velora/redis/server.key
VELORA_CRYPTO_KEY_FILE=/secure/velora/secrets/velora-crypto-key
VELORA_BOOTSTRAP_PASSWORD_FILE=/secure/velora/secrets/bootstrap-password
CASDOOR_OIDC_CLIENT_SECRET_FILE=/secure/velora/secrets/casdoor-oidc-client-secret
VELORA_TURNSTILE_SECRET_FILE=/secure/velora/secrets/turnstile-secret
DEMO_OIDC_CLIENT_SECRET_FILE=/secure/velora/secrets/demo-oidc-client-secret
DEMO_PROVISIONING_SECRET_FILE=/secure/velora/secrets/demo-provisioning-secret
DEMO_OIDC_ISSUER=https://auth.sevoniva.com
DEMO_OIDC_CLIENT_ID=replace-with-casdoor-demo-client-id
DEMO_OIDC_REDIRECT_URL=https://demo.sevoniva.com/oauth/callback
DEMO_PUBLIC_URL=https://demo.sevoniva.com
DEMO_POST_LOGOUT_REDIRECT_URL=https://home.sevoniva.com/login
# Required only when VELORA_CASDOOR_APPLICATION_AUTOMATION_ENABLED=true.
CASDOOR_AUTOMATION_TOKEN_FILE=/secure/velora/secrets/casdoor-automation-token
POSTGRES_CONTAINER=velora-prod-postgres

# Database bootstrap is performed only on an empty volume.
POSTGRES_SUPERUSER=replace-with-postgres-bootstrap-user
POSTGRES_SUPERUSER_PASSWORD_FILE=/secure/velora/secrets/postgres-superuser-password
POSTGRES_TLS_CERT_FILE=/secure/velora/secrets/postgres-tls-cert
POSTGRES_TLS_KEY_FILE=/secure/velora/secrets/postgres-tls-key
POSTGRES_TLS_CA_FILE=/secure/velora/secrets/postgres-tls-ca
POSTGRES_APP_USER=velora_app
POSTGRES_APP_PASSWORD_FILE=/secure/velora/secrets/postgres-app-password
POSTGRES_IDP_USER=casdoor_app
POSTGRES_IDP_PASSWORD_FILE=/secure/velora/secrets/postgres-idp-password
CASDOOR_DATA_SOURCE_NAME=user=casdoor_app password=URL_ENCODED_PASSWORD host=postgres port=5432 sslmode=require dbname=casdoor

LOG_LEVEL=info
