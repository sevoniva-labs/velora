[Unit]
Description=Renew and atomically deploy Velora TLS certificates
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/flock -n /run/velora-cert-renew.lock /usr/bin/certbot renew --quiet --no-random-sleep-on-renew --deploy-hook /opt/velora/source/scripts/deploy-renewed-certificates.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /opt/velora/prod/runtime/certs /opt/velora/prod/runtime/acme /run

[Install]
WantedBy=multi-user.target
