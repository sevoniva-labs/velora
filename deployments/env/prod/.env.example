# 生产部署变量模板。真实值必须由 Secret Manager/CI 注入，不要提交 .env。

DOCKER_REGISTRY=docker.io
GOPROXY=https://proxy.golang.org,direct
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

VELORA_EXTERNAL_URL=velora.example.com
VELORA_COOKIE_DOMAIN=
VELORA_DATABASE_URL=postgres://velora_app:URL_ENCODED_PASSWORD@postgres:5432/velora?sslmode=require
CASDOOR_DATA_SOURCE_NAME=user=casdoor_app password=URL_ENCODED_PASSWORD host=postgres port=5432 sslmode=require dbname=casdoor
CASDOOR_CLIENT_ID=replace-with-casdoor-client-id
CASDOOR_CLIENT_SECRET=replace-with-casdoor-client-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes
MAIL_CREDENTIAL_KEY=replace-with-base64-32-byte-key
REDIS_PASSWORD=replace-with-random-redis-password
REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379/0
TRUSTED_PROXIES=10.0.0.0/8
POSTGRES_CONTAINER=velora-prod-postgres

# PostgreSQL 首次初始化所需的独立账号；只在空数据目录首次启动时使用。
POSTGRES_SUPERUSER=replace-with-postgres-bootstrap-user
POSTGRES_SUPERUSER_PASSWORD=replace-with-postgres-bootstrap-password
POSTGRES_APP_USER=velora_app
POSTGRES_APP_PASSWORD=replace-with-velora-db-password
POSTGRES_IDP_USER=casdoor_app
POSTGRES_IDP_PASSWORD=replace-with-casdoor-db-password

# 可选非敏感配置
LOG_LEVEL=info
SESSION_TTL_HOURS=1
MAIL_SYNC_INTERVAL_MINUTES=10
HEALTH_CHECK_TIMEOUT_SECONDS=5
VELORA_ADMIN_ROLE=velora_admin
GRAFANA_ADMIN_USER=replace-with-grafana-admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
