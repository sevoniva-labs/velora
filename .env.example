# ============================================================================
# Velora 环境变量示例：复制为 .env 后按需修改。
# 禁止提交真实密码 / Secret / Token；本文件仅提供结构与默认值。
# ============================================================================

# --- Velora Server ---
VELORA_PORT=8080
VELORA_ENV=development
LOG_LEVEL=info

# --- PostgreSQL（Velora 独立 database，与 casdoor 隔离） ---
# 本地开发常用：postgres://velora:velora@127.0.0.1:5432/velora?sslmode=disable
DATABASE_URL=postgres://velora:velora@127.0.0.1:5432/velora?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# --- Redis（可选，第一阶段未强制使用） ---
REDIS_URL=

# --- Casdoor OIDC ---
CASDOOR_ISSUER=http://localhost:8443
CASDOOR_CLIENT_ID=velora
CASDOOR_CLIENT_SECRET=change-me-to-a-real-client-secret
CASDOOR_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback
# 回调后默认落点；由 OIDC state 中的 redirect 参数覆盖
CASDOOR_DEFAULT_REDIRECT=/home

# --- Session / Cookie ---
# 生产环境必须替换为至少 32 字节随机值：openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-secret
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Velora 角色约定（来自 Casdoor） ---
VELORA_ADMIN_ROLE=velora_admin

# --- CORS（浏览器直连后端时才需要；同源部署可留空） ---
CORS_ALLOWED_ORIGINS=

# --- 健康检查 ---
HEALTH_CHECK_TIMEOUT_SECONDS=5

# --- Docker 国内镜像（构建时可用 DOCKER_REGISTRY 覆盖） ---
DOCKER_REGISTRY=docker.m.daocloud.io
